# -----------------------------------------------------------------------------
# si-mapper Frontend - Runtime Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to docker.env and fill in real values before running:
#   docker compose --profile deploy up
#
# docker.env is listed in .gitignore and must NEVER be committed to source
# control as it may contain credentials.
# -----------------------------------------------------------------------------
# -- Agent backend (server-to-server) -----------------------------------------
# The Next.js container calls this URL from inside Docker, so "localhost" refers
# to the container itself, NOT the host machine. Choose the right value:
#
#   Agent runs in Docker (same compose stack):
#     AGENT_BACKEND_URL=http://si-mapper-agent:8001
#
#   Agent runs locally on the host (Docker Desktop - Windows / macOS):
#     AGENT_BACKEND_URL=http://host.docker.internal:8001
#
#   Agent runs locally on the host (Docker Engine on Linux):
#     AGENT_BACKEND_URL=http://172.17.0.1:8001
#
AGENT_BACKEND_URL=http://host.docker.internal:8001
# Agent backend - browser-to-server (must be reachable from the end-user's
# machine, i.e. via the publicly exposed port on the host).
NEXT_PUBLIC_AGENT_BACKEND_URL=http://localhost:8001
# -- Projects folder ----------------------------------------------------------
# Server-side path where the file-manager API (/api/files) reads and writes
# project files inside the container.
# Must match the right-hand side of the volumes bind-mount in docker-compose.yml:
#   ./mapper/uploads:/app/uploads  ->  PROJECTS_FOLDER=/app/uploads
PROJECTS_FOLDER=/app/uploads
# -- Neo4j (server-side only - never exposed to the browser) ------------------
NEO4J_BOLT_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
# -- Graph backend ------------------------------------------------------------
# Selects the graph database backend and operational mode.
#
#   neo4j_single     - Neo4j Community Edition.  All systems share the single
#                      "neo4j" database.  Per-system isolation is NOT enforced.
#                      Simplest setup; no Enterprise license required. (default)
#
#   neo4j_prefix     - Neo4j Community Edition.  All systems share the single
#                      "neo4j" database but each system's nodes are tagged with
#                      a _graph_ns property for per-system filtering.
#
#   neo4j_enterprise - Neo4j Enterprise Edition.  Each system gets its own
#                      named database (neo4j_db_name from the system record).
#                      CREATE DATABASE is managed automatically.
#                      Requires an Enterprise license.
#
#   graphdb          - Ontotext GraphDB Free.  Each system maps to its own
#                      GraphDB repository.  Requires GRAPHDB_REST_URL below.
#                      Uses SPARQL instead of Cypher.
#
GRAPH_BACKEND=neo4j_prefix
# -- GraphDB (only used when GRAPH_BACKEND=graphdb) ---------------------------
# Internal (server-to-server) URL of the GraphDB service.
#   Self-hosted Docker (same compose stack): http://graphdb:7200
#   Local dev:                               http://localhost:7200
#GRAPHDB_REST_URL=http://graphdb:7200
# Public (browser-reachable) URL of GraphDB - used for the "Open Workbench"
# link in the Graph tab.  If unset, falls back to GRAPHDB_REST_URL.
#   Self-hosted Docker: http://localhost:7200
#GRAPHDB_PUBLIC_URL=http://localhost:7200
# -- Graphivac (server-side only) ---------------------------------------------
# Internal (server-to-server) URL of the Graphivac service (no trailing slash, no /api/v1).
#   Self-hosted Docker (same compose stack): http://graphivac:8888
#   Cloud: https://graphivac.hvac.io
GRAPHIVAC_BASE_URL=http://graphivac:3000
# Public (browser-reachable) URL of Graphivac - used for the iframe src.
# If unset, falls back to GRAPHIVAC_BASE_URL (works for cloud deployments where both are identical).
#   Self-hosted Docker: http://localhost:8888
#   Cloud: https://graphivac.hvac.io
GRAPHIVAC_PUBLIC_BASE_URL=http://localhost:8888
# Organisation ID -- deployment-wide constant, never stored in project/system records.
GRAPHIVAC_ORG_ID=public