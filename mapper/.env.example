# -----------------------------------------------------------------------------
# si-mapper Frontend - Environment Variables (local development)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values before running:
#   cp .env.example .env.local
#
# .env.local is listed in .gitignore and must NEVER be committed to source
# control as it may contain credentials.
# -----------------------------------------------------------------------------
# Agent backend (FastAPI / ADK) - server-to-server.
#
# The Next.js dev server calls this URL from the host machine, so use
# localhost (or 127.0.0.1) and the port the agent is listening on:
#
#   Agent runs locally:
#     AGENT_BACKEND_URL=http://localhost:8001
#
#   Agent runs in Docker (Docker Desktop - Windows / macOS):
#     AGENT_BACKEND_URL=http://host.docker.internal:8001
#
AGENT_BACKEND_URL=http://localhost:8001
# Agent backend - browser-to-server (must be reachable from the end-user's
# machine, i.e. via the publicly exposed port on the host).
NEXT_PUBLIC_AGENT_BACKEND_URL=http://localhost:8001
# Projects folder - server-side path where the file-manager API (/api/files)
# reads and writes project files on the host machine.
PROJECTS_FOLDER=./uploads
# Neo4j connection (server-side only - never exposed to the browser).
NEO4J_BOLT_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
# Graphivac API -- server-side only.
# URL of the Graphivac service (no trailing slash, no /api/v1).
#   Local dev or cloud: https://graphivac.hvac.io
#   Self-hosted Docker (same compose stack): http://graphivac:8888
GRAPHIVAC_BASE_URL=https://graphivac.hvac.io
# Public (browser-reachable) URL of Graphivac - used for the iframe src.
# If unset, falls back to GRAPHIVAC_BASE_URL (works for cloud deployments where both are identical).
#   Local dev or cloud: https://graphivac.hvac.io
#   Self-hosted Docker: http://localhost:8888
GRAPHIVAC_PUBLIC_BASE_URL=https://graphivac.hvac.io
# Organisation ID -- deployment-wide constant, never stored in project/system records.
GRAPHIVAC_ORG_ID=public
