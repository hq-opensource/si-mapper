# ============================================================
# SI-MAPPER Frontend — Environment Variables Reference
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# .env.local is gitignored and should never be committed.
# Docker deployments pass these via docker-compose.yml
# `environment:` or `env_file:` directives.
# ============================================================

# ------------------------------------------------------------
# SERVER-SIDE VARIABLES
# These are used only in API routes and are NEVER sent to
# the browser. Do NOT add the NEXT_PUBLIC_ prefix here.
# ------------------------------------------------------------

# Full base URL of the ADK agent's FastAPI server.
# Change this when the agent runs on a different host or port
# (e.g. inside a Docker network where the host is "agent").
AGENT_BACKEND_URL=http://127.0.0.1:8001

# Absolute path to the root folder where all project files
# are stored. In Docker, this must exactly match the
# container-side mount point of the projects volume.
# Example for Docker: PROJECTS_FOLDER=/app/uploads
PROJECTS_FOLDER=./uploads

# Neo4j connection details.
NEO4J_BOLT_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ------------------------------------------------------------
# CLIENT-SIDE VARIABLES  (NEXT_PUBLIC_ prefix)
# Next.js inlines these at BUILD TIME into the browser bundle.
# Do not store secrets here.
# ------------------------------------------------------------

# Agent polling base URL — must be reachable from the browser.
# Usually the same host/port as AGENT_BACKEND_URL but accessed
# from the client side (i.e. from the user's browser).
NEXT_PUBLIC_AGENT_BACKEND_URL=http://localhost:8001

# Full Graphivac grid URL without query parameters.
# Example: https://graphivac.hvac.io/o/public/p/<pid>/g/<gid>
# Leave empty to show a placeholder instead of the iframe.
NEXT_PUBLIC_GRAPHIVAC_GRID_URL=

# Graphivac API -- server-side only.
# Base URL of the Graphivac service (no trailing slash).
GRAPHIVAC_BASE_URL=https://graphivac.hvac.io
# Organisation ID -- deployment-wide constant, never stored in project/system records.
GRAPHIVAC_ORG_ID=public
