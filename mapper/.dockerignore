node_modules/
.pnpm-store/

# Next.js build output — will be generated inside the image
.next/
out/

# Uploads — mounted as a Docker volume at runtime
uploads/

# Environment files — injected via env_file in docker-compose.yml
.env
.env.local
.env.*.local
frontend.env
docker.env

# Development / OS artifacts
*.log
*.pem
.DS_Store
Thumbs.db
coverage/
.yarn/

# TypeScript / IDE artifacts
*.tsbuildinfo

# Git
.git/
.gitignore


