{
  "name": "adk-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:all",
    "start": "pnpm run start:all",
    "start:all": "concurrently \"pnpm run start:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "start:ui": "next start",
    "dev:all": "concurrently \"pnpm run dev:ui\" \"pnpm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "cross-env LOG_LEVEL=debug pnpm run dev:all",
    "dev:agent": "cd ../agent && cross-env VIRTUAL_ENV=\"\" PYTHONWARNINGS=ignore uv run main.py",
    "dev:ui": "next dev --turbopack",
    "build": "next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "next lint",
    "install:python": "node scripts/setup.js",
    "postinstall": "pnpm run install:python"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.47",
    "@ag-ui/langgraph": "^0.0.24",
    "@copilotkit/react-core": "1.53.0",
    "@copilotkit/react-ui": "1.53.0",
    "@copilotkit/runtime": "1.53.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-sigma/core": "^5.0.6",
    "@react-sigma/layout-core": "^5.0.6",
    "@react-sigma/layout-forceatlas2": "^5.0.6",
    "@svar-ui/react-filemanager": "^2.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "lucide-react": "^0.555.0",
    "neo4j-driver": "^6.0.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sigma": "^3.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.0"
    }
  }
}