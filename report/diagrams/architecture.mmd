flowchart LR

    subgraph AGENT["AI Agent · Google ADK · FastAPI :8001"]
        direction TB

        MA["MasterLlmAgent\nGemini 3.1 Pro · T=1.0\nNative Thinking HIGH\nMasterMainLoopAgent · 100 iter. max"]

        subgraph SKILLS["Skills — 7 Skills"]
            direction TB
            SK1["skill-ductwork — Identification & routing of HVAC ducts"]
            SK2["skill-hvac-equipments — Equipment placement on the grid"]
            SK3["skill-bacnet-points — BACnet CSV point extraction & mapping"]
            SK4["skill-ontology-generation — ASHRAE 223P ontology generation (Python)"]
            SK5["skill-ontology-validation — Iterative TTL validation & correction"]
            SK6["skill-ontology-lessons — Knowledge base of past errors"]
            SK7["skill-control-points — Control point extraction"]
        end

        subgraph TOOLS["Tools — 25 tools"]
            direction TB
            TGN["Internal Grid (7)\nadd_component · add_components_batch\ndelete_component · delete_components_batch\nread_internal_grid · update_component_metadata · _batch"]
            TSN["GraphiVAC Sync (2)\nsync_graphivac_to_agent · sync_agent_to_graphivac"]
            TNN["Neo4j (5)\nexecute_cypher · execute_cypher_batch\nget_graph_schema · search_graph_entities · load_ttl_to_neo4j"]
            TON["Ontology (6)\nread_python_files · scan_python_folder · search_class_mapping\nwrite_ontology · execute_ontology · extract_lessons"]
            TMN["Management (5)\ningest_category_files · update_step · update_status · update_state\nsave_agent_state · get_agent_state · exit_with_success · exit_with_failure"]
        end

        MA --> SKILLS
        MA --> TOOLS
    end

    subgraph FRONTEND["Interface · CopilotKit + Next.js · Mapper"]
        direction TB

        FHU["CopilotKit Chat HUD\nSplitSidebar · Controls & Status"]

        subgraph FTABS["Workspace Tabs"]
            direction LR
            FT1["Thoughts\n(LLM reasoning)"]
            FT2["Files\n(HVAC/BACnet upload)"]
            FT3["View\n(GraphiVAC canvas)"]
            FT4["Graph\n(React Sigma / Neo4j)"]
            FT5["Python / TTL\n(ontology code)"]
            FT6["Debug / State\n(tool log & state)"]
        end

        subgraph FAPI["Next.js API Routes"]
            direction TB
            FAC["/api/copilotkit\n(proxy → FastAPI :8001)"]
            FAG["/api/graph\n(Neo4j → Sigma.js)"]
            FAF["/api/files\n(upload & read)"]
        end
    end

    subgraph EXT["External Services"]
        direction TB

        LLM["Google Gemini 3.1 Pro\nCloud LLM · Native ThinkingConfig\nHIGH reasoning"]

        subgraph GVAC["GraphiVAC Platform"]
            direction TB
            GVR["REST API (EDN format)\nGET / PUT HVAC grid"]
            GVV["Render Interface\n(visual HVAC canvas)"]
        end

        subgraph NEO4J["Neo4j + Neosemantics n10s"]
            direction TB
            NDB["Graph Database (Bolt :7687)\nASHRAE 223P Ontology"]
            NIO["n10s.rdf.import.inline\n(TTL / Turtle import)"]
        end

        subgraph FFS["Local Files"]
            direction TB
            FFU["mapper/uploads/ hvac · bacnet · pdf"]
            FFP["uploads/python/latest_ontology.py"]
            FFT["uploads/ttl/latest_ontology.ttl"]
        end
    end

    %% ── Agent ↔ Frontend ─────────────────────────────────────────────
    MA <-->|"WebSocket streaming\nthoughts · events · state"| FAC
    MA <-.->|"Polling fallback /session_state (2 s)"| FAC

    %% ── Agent → LLM ──────────────────────────────────────────────────
    MA ==>|"Google ADK"| LLM

    %% ── Agent ↔ GraphiVAC ────────────────────────────────────────────
    TSN <-->|"GET / PUT EDN"| GVR

    %% ── Agent → Neo4j ────────────────────────────────────────────────
    TNN -->|"Cypher (read)"| NDB
    TNN -->|"wipe + reimport"| NIO
    NIO --> NDB

    %% ── Agent → Local Files ──────────────────────────────────────────
    TON -->|"write_ontology"| FFP
    TON -->|"execute_ontology → TTL"| FFT
    TMN -->|"ingest_category_files"| FFU

    %% ── Frontend ↔ External Services ────────────────────────────────
    FT3 -->|"iframe"| GVV
    FAG <-->|"Cypher (Bolt)"| NDB
    FAF <-->|"read / write"| FFU
    FFT -->|"imported via n10s"| NIO

