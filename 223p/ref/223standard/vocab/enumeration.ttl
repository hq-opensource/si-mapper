.
s223:Water-GlycolSolution
  a s223:Class ;
  a s223:Water-GlycolSolution ;
  a sh:NodeShape ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-Glycol ;
      qudt:hasQuantityKind qudtqk:VolumeFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Unspecified" ;
    ] ;
  s223:composedOf [
      a s223:QuantifiableProperty ;
      s223:ofConstituent s223:Constituent-H2O ;
      qudt:hasQuantityKind qudtqk:VolumeFraction ;
      qudt:hasUnit unit:PERCENT ;
      rdfs:label "Unspecified" ;
    ] ;
  s223:hasFreezingPoint [
      a s223:QuantifiableProperty ;
      qudt:hasQuantityKind qudtqk:Temperature ;
      rdfs:label "Freezing point" ;
    ] ;
  doc:subclauses (
      s223:hasFreezingPoint
    ) ;
  rdfs:comment """This class and its enumerated subclasses represent common concentrations of water-glycol solution.

: Water-GlycolSolution Enumerations

| Enumeration |
|:-----------|
| `GlycolSolution-15Percent` |
| `GlycolSolution-30Percent` |""" ;
  rdfs:label "Water-Glycol solution" ;
  rdfs:subClassOf s223:Fluid-Water ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-Glycol`." ;
      sh:message "s223: One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-Glycol`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:QuantifiableProperty ;
          sh:node [
              sh:property [
                  sh:path s223:ofConstituent ;
                  rdfs:comment "One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-Glycol`." ;
                  sh:class s223:Constituent-Glycol ;
                ] ;
              sh:property [
                  sh:path qudt:hasQuantityKind ;
                  rdfs:comment "The `QuantityKind` of the constituent shall be `VolumeFraction`." ;
                  sh:in ( qudtqk:VolumeFraction ) ;
                ] ;
            ] ;
        ] ;
      sh:qualifiedValueShapesDisjoint true ;
    ] ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-H2O`." ;
      sh:message "s223: One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-H2O`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:QuantifiableProperty ;
          sh:node [
              sh:property [
                  sh:path s223:ofConstituent ;
                  rdfs:comment "One of the constituents of a `Water-GlycolSolution` shall be a `Constituent-H2O`." ;
                  sh:class s223:Constituent-H2O ;
                ] ;
              sh:property [
                  sh:path qudt:hasQuantityKind ;
                  rdfs:comment "The `QuantityKind` of the constituent shall be `VolumeFraction`." ;
                  sh:in ( qudtqk:VolumeFraction ) ;
                ] ;
            ] ;
        ] ;
      sh:qualifiedValueShapesDisjoint true ;
    ] ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "A `Water-GlycolSolution` shall be associated with at least two `QuantifiableProperty`s using the relation `composedOf`. These characterize the constituents of a `Water-GlycolSolution`." ;
      sh:class s223:QuantifiableProperty ;
      sh:message "s223: A `Water-GlycolSolution` shall be associated with at least two `QuantifiableProperty`s using the relation `composedOf`. These characterize the constituents of a `Water-GlycolSolution`." ;
      sh:minCount 2 ;
    ] ;
  sh:property [
      sh:path s223:hasFreezingPoint ;
      rdfs:comment "A `Water-GlycolSolution` shall be associated with zero or more `QuantifiableProperty`s with a `QuantityKind` of `Temperature` using the relation `hasFreezingPoint`." ;
      sh:class s223:QuantifiableProperty ;
      sh:message "s223: A `Water-GlycolSolution` shall be associated with zero or more `QuantifiableProperty`s with a `QuantityKind` of `Temperature` using the relation `hasFreezingPoint`." ;
      sh:node [
          sh:property [
              sh:path qudt:hasQuantityKind ;
              sh:in ( qudtqk:Temperature ) ;
            ] ;
        ] ;
    ] ;
.
