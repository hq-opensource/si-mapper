s223:Aspect-Alarm
  a s223:Aspect-Alarm ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value indicates whether an alarm condition is active or provides details about an active alarm." ;
  rdfs:label "Alarm" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-CatalogNumber
  a s223:Aspect-CatalogNumber ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a number or other identifier of a product in a manufacturer’s catalog." ;
  rdfs:label "Catalog number" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Deadband
  a s223:Aspect-Deadband ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a range around a setpoint where no control action is taken to avoid unnecessary corrections." ;
  rdfs:label "Deadband" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Delta
  a s223:Aspect-Delta ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a differential value (e.g., pressure difference) instead of an absolute value." ;
  rdfs:label "Delta" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Fault
  a s223:Aspect-Fault ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a fault indicator or code that signals a malfunction or issue with the system or equipment." ;
  rdfs:label "Fault" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-HighLimit
  a s223:Aspect-HighLimit ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is an upper threshold used in a control or alarm detection algorithm." ;
  rdfs:label "High limit" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-LowLimit
  a s223:Aspect-LowLimit ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a lower threshold used in a control or alarm detection algorithm." ;
  rdfs:label "Low limit" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Manufacturer
  a s223:Aspect-Manufacturer ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a name or other identifier of the product’s manufacturer." ;
  rdfs:label "Manufacturer" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Maximum
  a s223:Aspect-Maximum ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a highest specified or observed value. (Examples: upper limit of the specified operating voltage range; maximum measured temperature.)" ;
  rdfs:label "Maximum" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Minimum
  a s223:Aspect-Minimum ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a lowest specified or observed value. (Examples: lower limit of the specified operating voltage range; minimum measured temperature.)" ;
  rdfs:label "Minimum" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Model
  a s223:Aspect-Model ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a model identifier of the product." ;
  rdfs:label "Model" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Nominal
  a s223:Aspect-Nominal ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a value that is expected or desired under normal operating conditions, but may not reflect the actual value at all times. (Example: nominal voltage.)" ;
  rdfs:label "Nominal" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-OperatingMode
  a s223:Aspect-OperatingMode ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is the current intended mode of operation, such as 'Automatic', 'On', or 'Off'." ;
  rdfs:label "Operating mode" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-OperatingStatus
  a s223:Aspect-OperatingStatus ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is the current operational status of the system or equipment, such as 'Running,' 'Stopped,' or 'Maintenance Mode.'" ;
  rdfs:label "Operating status" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Rated
  a s223:Aspect-Rated ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value indicates a limit for continuous safe operation set by the manufacturer, but may not reflect the actual value at all times. (Example: rated voltage.)" ;
  rdfs:label "Rated" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-SerialNumber
  a s223:Aspect-SerialNumber ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is the serial number assigned by the manufacturer to the system or equipment." ;
  rdfs:label "Serial number" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Setpoint
  a s223:Aspect-Setpoint ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a target value for a control algorithm." ;
  rdfs:label "Setpoint" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Aspect-Threshold
  a s223:Aspect-Threshold ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "The property value is a threshold used in a control algorithm." ;
  rdfs:label "Threshold" ;
  rdfs:subClassOf s223:EnumerationKind-Aspect ;
.
s223:Binary-Logical
  a s223:Binary-Logical ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment """This class and its enumerated subclasses represent the possible values of a logical `Property` i.e., True or False.

: Binary-Logical Enumerations

| Enumeration |
|:-----------|
| `Logical-False` |
| `Logical-True` |""" ;
  rdfs:label "Logical" ;
  rdfs:subClassOf s223:EnumerationKind-Binary ;
.
s223:Binary-OnOff
  a s223:Binary-OnOff ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment """This class and its enumerated subclasses represent basic operational states i.e., On and Off.

: Binary-OnOff Enumerations

| Enumeration |
|:-----------|
| `OnOff-Off` |
| `OnOff-On` |""" ;
  rdfs:label "On/off" ;
  rdfs:subClassOf s223:EnumerationKind-Binary ;
.
s223:Binary-Position
  a s223:Binary-Position ;
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment """This class and its enumerated subclasses represent basic positional states i.e., Closed and Open.

: Binary-Position Enumerations

| Enumeration |
|:-----------|
| `Position-Closed` |
| `Position-Open` |""" ;
  rdfs:label "Position" ;
  rdfs:subClassOf s223:EnumerationKind-Binary ;
.
