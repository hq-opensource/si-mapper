| `Weekday-Monday` |
| `Weekday-Thursday` |
| `Weekday-Tuesday` |
| `Weekday-Wednesday` |""" ;
  rdfs:label "Weekday" ;
  rdfs:subClassOf s223:EnumerationKind-DayOfWeek ;
.
