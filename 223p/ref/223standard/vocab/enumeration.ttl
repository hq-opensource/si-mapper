s223:PowerAndSignal-PoE
  a s223:Class ;
  a s223:PowerAndSignal-PoE ;
  a sh:NodeShape ;
  s223:composedOf [
      a s223:Property ;
      s223:ofConstituent s223:DC-PoE ;
      rdfs:label "Unspecified" ;
    ] ;
  s223:composedOf [
      a s223:Property ;
      s223:ofConstituent s223:Signal-WiredEthernet ;
      rdfs:label "Unspecified" ;
    ] ;
  rdfs:comment "PowerAndSignal-PoE" ;
  rdfs:label "Power over Ethernet (PoE)" ;
  rdfs:subClassOf s223:Mix-PowerAndSignal ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "One of the constituents of a `PowerAndSignal-PoE` shall be a `DC-PoE`." ;
      sh:message "s223: One of the constituents of a `PowerAndSignal-PoE` shall be a `DC-PoE`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:Property ;
          sh:node [
              sh:property [
                  sh:path s223:ofConstituent ;
                  sh:class s223:DC-PoE ;
                ] ;
            ] ;
        ] ;
      sh:qualifiedValueShapesDisjoint true ;
    ] ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "One of the constituents of a `PowerAndSignal-PoE` shall be a `Signal-WiredEthernet`." ;
      sh:message "s223: One of the constituents of a `PowerAndSignal-PoE` shall be a `Signal-WiredEthernet`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:Property ;
          sh:node [
              sh:property [
                  sh:path s223:ofConstituent ;
                  sh:class s223:Signal-WiredEthernet ;
                ] ;
            ] ;
        ] ;
      sh:qualifiedValueShapesDisjoint true ;
    ] ;
  sh:property [
      sh:path s223:composedOf ;
      rdfs:comment "A `PowerAndSignal-PoE` shall be associated with at least two `Property`s using the relation `composedOf`. These characterize the constituents of Power over Ethernet (PoE)." ;
      sh:class s223:Property ;
      sh:message "s223: A `PowerAndSignal-PoE` shall be associated with at least two `Property`s using the relation `composedOf`. These characterize the constituents of Power over Ethernet (PoE)." ;
      sh:minCount 2 ;
    ] ;
.
