      s223:hasDCDifferentialVoltage
      s223:hasDCPositiveVoltage
      s223:hasDCNegativeVoltage
      s223:hasDCZeroVoltage
      s223:DC-12V
      s223:DC-24V
      s223:DC-380V
      s223:DC-48V
      s223:DC-5V
      s223:DC-6V
      s223:DC-PoE
    ) ;
  rdfs:comment """This class and its enumerated subclasses represent common DC electricity services.

: Electricity-DC Enumerations

| Enumeration |
|:-----------|
| `DC-5V` |
| `DC-6V` |
| `DC-12V` |
| `DC-24V` |
| `DC-48V` |
| `DC-380V` |
| `DC-PoE` |""" ;
  rdfs:label "DC electricity" ;
  rdfs:subClassOf s223:Constituent-Electricity ;
  s223:hasDCDifferentialVoltage s223:Numerical-Voltage ;
  sh:property [
      sh:path s223:hasDCDifferentialVoltage ;
      rdfs:comment "An `Electricity-DC` shall be associated with at least one `Numerical-Voltage` using the relation `hasDCDifferentialVoltage`." ;
      sh:class s223:Numerical-Voltage ;
      sh:message "s223: An `Electricity-DC` shall be associated with at least one `Numerical-Voltage` using the relation `hasDCDifferentialVoltage`." ;
      sh:minCount 1 ;
    ] ;
  sh:property [
      sh:path s223:hasDCPositiveVoltage ;
      rdfs:comment "An `Electricity-DC` shall be associated with zero or more `Numerical-Voltage`s using the relation `hasDCPositiveVoltage`." ;
      sh:class s223:Numerical-Voltage ;
      sh:message "s223: An `Electricity-DC` shall be associated with zero or more `Numerical-Voltage`s using the relation `hasDCPositiveVoltage`." ;
    ] ;
  sh:property [
      sh:path s223:hasDCZeroVoltage ;
      rdfs:comment "An `Electricity-DC` shall be associated with zero or more `Voltage-0V`s using the relation `hasDCZeroVoltage`." ;
      sh:class s223:Voltage-0V ;
      sh:message "s223: An `Electricity-DC` shall be associated with zero or more `Voltage-0V`s using the relation `hasDCZeroVoltage`." ;
    ] ;
  sh:property [
      sh:path s223:hasDCNegativeVoltage ;
      rdfs:comment "An `Electricity-DC` shall be associated with zero or more `Numerical-Voltage`s using the relation `hasDCNegativeVoltage`." ;
      sh:class s223:Numerical-Voltage ;
      sh:message "s223: An `Electricity-DC` shall be associated with zero or more `Numerical-Voltage`s using the relation `hasDCNegativeVoltage`." ;
    ] ;
.
