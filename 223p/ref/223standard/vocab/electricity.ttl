s223:Numerical-Frequency
  a s223:Class ;
  a s223:Numerical-Frequency ;
  a sh:NodeShape ;
  qudt:hasQuantityKind qudtqk:Frequency ;
  qudt:hasUnit unit:HZ ;
  rdfs:comment """This class and its enumerated subclasses represent common frequencies for AC electricity service.

: Numerical-Frequency Enumerations

| Enumeration |
|:-----------|
| `Frequency-50Hz` |
| `Frequency-60Hz` |""" ;
  rdfs:label "Frequency" ;
  rdfs:subClassOf s223:EnumerationKind-Numerical ;
  sh:property [
      sh:path qudt:hasQuantityKind ;
      rdfs:comment "A `Numerical-Frequency` shall have a `QuantityKind` of `Frequency`." ;
      sh:in ( qudtqk:Frequency ) ;
      sh:message "s223: A `Numerical-Frequency` shall have a `QuantityKind` of `Frequency`." ;
    ] ;
  sh:property [
      sh:path qudt:hasUnit ;
      rdfs:comment "A `Numerical-Frequency` shall have a `Unit` of `HZ` (hertz)." ;
      sh:in ( unit:HZ ) ;
      sh:message "s223: A `Numerical-Frequency` shall have a `Unit` of `HZ` (hertz)." ;
    ] ;
.
s223:Numerical-NumberOfElectricalPhases
  a s223:Class ;
  a s223:Numerical-NumberOfElectricalPhases ;
  a sh:NodeShape ;
  qudt:hasQuantityKind qudtqk:NumberOfElectricalPhases ;
  qudt:hasUnit unit:NUM ;
  rdfs:comment """This class and its enumerated subclasses represent all possible service phases for AC electricity service, i.e., single-phase or three-phase. The `hasNumberOfElectricalPhases` relation points to one of the values of this enumeration.

: Numerical-NumberOfElectricalPhases Enumerations

| Enumeration |
|:-----------|
| `NumberOfElectricalPhases-SinglePhase` |
| `NumberOfElectricalPhases-ThreePhase` |""" ;
  rdfs:label "Number of electrical phases" ;
  rdfs:subClassOf s223:EnumerationKind-Numerical ;
.
