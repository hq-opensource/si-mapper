# baseURI: http://data.ashrae.org/standard223/1.0/data/stacked-zones
# imports: http://data.ashrae.org/standard223/1.0/model/all
# prefix: stacked-zones

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stacked-zones: <http://data.ashrae.org/standard223/1.0/data/stacked-zones#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

s223:ConnectionPoint
  sh:property [] ;
.
<http://data.ashrae.org/standard223/1.0/data/stacked-zones>
  a owl:Ontology ;
  rdfs:comment "This graph is defined to test various scenarios of Zones within Zones at multiple depths." ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
stacked-zones:DomainSpace_1
  a s223:DomainSpace ;
  s223:hasConnectionPoint stacked-zones:InletConnectionPoint_1 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "DomainSpace 1" ;
.
stacked-zones:DomainSpace_6
  a s223:DomainSpace ;
  s223:hasConnectionPoint stacked-zones:OutletDomainSpace6 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "Domain space 6" ;
.
stacked-zones:Duct_1
  a s223:Duct ;
  s223:hasMedium s223:Fluid-Air ;
  rdfs:label "Duct 1" ;
.
stacked-zones:InletConnectionPoint_1
  a s223:InletConnectionPoint ;
  s223:cnx stacked-zones:Duct_1 ;
  s223:hasMedium s223:AC-277V-60Hz ;
  rdfs:label "Inlet connection point 1" ;
.
stacked-zones:InletZoneConnectionPoint_1
  a s223:InletZoneConnectionPoint ;
  s223:hasMedium s223:AC-120V-60Hz ;
  s223:mapsTo stacked-zones:InletConnectionPoint_1 ;
  rdfs:label "Inlet zone connection point 1" ;
.
stacked-zones:InletZoneConnectionPoint_3
  a s223:InletZoneConnectionPoint ;
  s223:hasMedium s223:Constituent-Electricity ;
  s223:mapsTo stacked-zones:InletConnectionPoint_1 ;
  rdfs:label "Inlet zone connection point 3" ;
.
stacked-zones:OutletDomainSpace6
  a s223:OutletConnectionPoint ;
  s223:hasMedium s223:Fluid-Air ;
  rdfs:label "Outlet domain space6" ;
.
stacked-zones:Zone_1
  a s223:Zone ;
  s223:contains stacked-zones:Zone_2 ;
  s223:contains stacked-zones:Zone_3 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "Zone 1" ;
.
stacked-zones:Zone_2
  a s223:Zone ;
  s223:contains stacked-zones:Zone_4 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "Zone 2" ;
.
stacked-zones:Zone_3
  a s223:Zone ;
  s223:contains stacked-zones:Zone_6 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "Zone 3" ;
.
stacked-zones:Zone_4
  a s223:Zone ;
  s223:contains stacked-zones:DomainSpace_1 ;
  s223:hasDomain s223:Domain-HVAC ;
  s223:hasZoneConnectionPoint stacked-zones:InletZoneConnectionPoint_1 ;
  rdfs:label "Zone 4" ;
.
stacked-zones:Zone_6
  a s223:Zone ;
  s223:contains stacked-zones:DomainSpace_6 ;
  s223:hasDomain s223:Domain-HVAC ;
  rdfs:label "Zone 6" ;
.
