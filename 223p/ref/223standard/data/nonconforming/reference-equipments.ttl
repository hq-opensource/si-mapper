@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix ex: <http://data.ashrae.org/standard223/reference-equipments#> .


ex:Actuator a s223:Actuator ;
    s223:actuatedByProperty [ a s223:QuantifiableActuatableProperty]
.

ex:AirHandlingUnit a s223:AirHandlingUnit ;
    s223:cnx ex:ahu_in, ex:ahu_out ;
.
ex:ahu_in a s223:InletConnectionPoint; 
    s223:hasMedium s223:Fluid-Air;
.
ex:ahu_out a s223:OutletConnectionPoint; 
    s223:hasMedium s223:Fluid-Air ;
.

ex:Boiler a s223:Boiler ;
    s223:cnx ex:boi_in, ex:boi_out ;
.
ex:boi_in a s223:InletConnectionPoint; 
    s223:hasMedium s223:Fluid-Water;
.
ex:boi_out a s223:OutletConnectionPoint; 
    s223:hasMedium s223:Water-Steam ;
.

ex:Chiller a s223:Chiller ;
    s223:cnx ex:chiller_in, ex:chiller_out ;
.
ex:chiller_in a s223:InletConnectionPoint; 
    s223:hasMedium s223:Fluid-Water;
.
ex:chiller_out a s223:OutletConnectionPoint; 
    s223:hasMedium s223:Fluid-Water ;
.
