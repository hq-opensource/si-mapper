<http://data.ashrae.org/standard223/1.0/data/library/lib002>
  a owl:Ontology ;
  rdfs:comment "Pattern for a smart electric switch that reads a Property value from a single Sensor (e.g. a user button, or an occupancy sensor). This value is used as input to a Function that computes a command to open or close a Relay." ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
