# baseURI: http://data.ashrae.org/standard223/1.0/data/library/lib001
# imports: http://data.ashrae.org/standard223/1.0/model/all
# prefix: lib001

@prefix lib001: <http://data.ashrae.org/standard223/1.0/data/library/lib001#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.ashrae.org/standard223/1.0/data/library/lib001>
  a owl:Ontology ;
  rdfs:comment "Pattern for a simple electric switch. This could be used for a mechanical switch that does not read or write any data (Property value), or for some kind of smart switch modeled without exposing the internal circuitry and/or Properties. The switch is modeled as an instance of s223:Equipment, and is connected to instances of s223:InletConnectionPoint and s223:OutletConnectionPoint." ;
  owl:imports <http://data.ashrae.org/standard223/1.0/model/all> ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
lib001:a001
  a s223:Equipment ;
  s223:cnx lib001:a002 ;
  s223:cnx lib001:a003 ;
  rdfs:label "Switch001" ;
.
lib001:a002
  a s223:InletConnectionPoint ;
  s223:hasMedium s223:Constituent-Electricity ;
  rdfs:label "InletCP2" ;
.
lib001:a003
  a s223:OutletConnectionPoint ;
  s223:hasMedium s223:Constituent-Electricity ;
  rdfs:label "OutletCP3" ;
.
