# -- LLM Provider -------------------------------------------------------------
# Model name to use for the agent (see agent/README.md for supported models)
# Examples: gemini-3.1-pro  claude-sonnet-4-6  gpt-5.4-2026-03-05
SHARED_ADK_MODEL=gemini-3.1-pro
# Google Gemini API key (required when SHARED_ADK_MODEL is a Gemini model)
GOOGLE_API_KEY=
# Anthropic API key (required when SHARED_ADK_MODEL is a Claude model)
ANTHROPIC_API_KEY=
# OpenAI API key (required when SHARED_ADK_MODEL is a GPT model)
OPENAI_API_KEY=
# GitHub personal access token (used by the read-code skill to fetch private repositories)
GITHUB_TOKEN=
# -- Graphivac ----------------------------------------------------------------
# URL of the Graphivac service (no trailing slash, no /api/v1).
#   Local dev or cloud:                      https://graphivac.hvac.io
#   Self-hosted Docker (same compose stack): http://graphivac:8888
GRAPHIVAC_BASE_URL=http://localhost:8888
GRAPHIVAC_ORG_ID=public
GRAPHIVAC_PROJECT_ID=P-XXXXXXXX
GRAPHIVAC_GRID_ID=G-XXXXXXXX
# -- Project Storage ----------------------------------------------------------
# Path to the folder where project files are stored on the host machine.
# Default matches: ./uploads
PROJECTS_FOLDER=./uploads
# -- Neo4j (optional - used by some agent tools) ------------------------------
NEO4J_BOLT_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
# -- Graph backend ------------------------------------------------------------
# Selects the graph database backend and operational mode.
#
#   neo4j_single     - Neo4j Community Edition.  All systems share the single
#                      "neo4j" database.  Per-system isolation is NOT enforced.
#                      Simplest setup; no Enterprise license required. (default)
#
#   neo4j_prefix     - Neo4j Community Edition.  All systems share the single
#                      "neo4j" database but each system's nodes are tagged with
#                      a _graph_ns property for per-system filtering.
#
#   neo4j_enterprise - Neo4j Enterprise Edition.  Each system gets its own
#                      named database (neo4j_db_name from the system record).
#                      CREATE DATABASE is managed automatically.
#                      Requires an Enterprise license.
#
#   graphdb          - Ontotext GraphDB Free.  Each system maps to its own
#                      GraphDB repository.  Requires GRAPHDB_REST_URL below.
#                      Uses SPARQL instead of Cypher.
#
GRAPH_BACKEND=neo4j_single
# -- GraphDB (only used when GRAPH_BACKEND=graphdb) ---------------------------
# Internal (server-to-server) URL of the GraphDB service.
#   Self-hosted Docker (same compose stack): http://graphdb:7200
#   Local dev:                               http://localhost:7200
#GRAPHDB_REST_URL=http://graphdb:7200
# -- Service ------------------------------------------------------------------
DEBUG_LEVEL=INFO
PORT=8001
# -- Session persistence (13-11) ----------------------------------------------
# Path to the SQLite sessions database.
# In Docker, ensure this path is on a named volume for persistence.
SESSIONS_DB_PATH=./app/data/sessions.db