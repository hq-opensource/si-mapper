  sh:property [
      sh:path s223:hasRole ;
      rdfs:comment "A `HeatingCoil` shall at least have the role `Role-Heating`." ;
      sh:message "s223: A `HeatingCoil` shall at least have the role `Role-Heating`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:Role-Heating ;
        ] ;
    ] ;
.
s223:Humidifier
  a s223:Class ;
