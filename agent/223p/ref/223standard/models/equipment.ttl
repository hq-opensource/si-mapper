      sh:path s223:hasConnectionPoint ;
      rdfs:comment "A `GroundToAirHeatPump` shall have at least one bidirectional connection point using the medium `Medium-ThermalContact`." ;
      sh:message "s223: A `GroundToAirHeatPump` shall have at least one bidirectional connection point using the medium `Medium-ThermalContact`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:BidirectionalConnectionPoint ;
          sh:node [
              sh:property [
