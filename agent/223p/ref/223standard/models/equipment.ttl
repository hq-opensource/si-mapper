s223:Monitor
  a s223:Class ;
  a sh:NodeShape ;
  rdfs:comment "An `ElectronicDisplay` designed primarily for the output of visual information supplied by a `Computer`." ;
  rdfs:label "Monitor" ;
  rdfs:subClassOf s223:ElectronicDisplay ;
