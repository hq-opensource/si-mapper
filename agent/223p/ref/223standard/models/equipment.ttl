  rdfs:comment "An `ElectricEnergyConverter` that tranforms direct current (DC) electric power to alternating current (AC) electric power, or vice versa." ;
  rdfs:label "Electric energy inverter" ;
  rdfs:subClassOf s223:ElectricEnergyConverter ;
  sh:property [
      sh:path s223:hasConnectionPoint ;
      rdfs:comment "An `ElectricEnergyInverter` shall have at least one connection point using the medium `Electricity-AC`." ;
      sh:message "s223: An `ElectricEnergyInverter` shall have at least one connection point using the medium `Electricity-AC`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:ConnectionPoint ;
          sh:node [
              sh:property [
                  sh:path s223:hasMedium ;
                  sh:class s223:Electricity-AC ;
                ] ;
            ] ;
        ] ;
    ] ;
  sh:property [
      sh:path s223:hasConnectionPoint ;
      rdfs:comment "An `ElectricEnergyInverter` shall have at least one connection point using the medium `Electricity-DC`." ;
      sh:message "s223: An `ElectricEnergyInverter` shall have at least one connection point using the medium `Electricity-DC`." ;
      sh:qualifiedMinCount 1 ;
      sh:qualifiedValueShape [
          sh:class s223:ConnectionPoint ;
          sh:node [
              sh:property [
                  sh:path s223:hasMedium ;
                  sh:class s223:Electricity-DC ;
                ] ;
            ] ;
        ] ;
    ] ;
