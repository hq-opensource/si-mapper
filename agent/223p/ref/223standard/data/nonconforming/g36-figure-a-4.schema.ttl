@prefix bob: <http://data.ashrae.org/standard223/si-builder#> .
@prefix ex: <http://example/> .
@prefix g36: <http://data.ashrae.org/standard223/1.0/extension/g36#> .
@prefix p223: <http://data.ashrae.org/proposal-to-standard223#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


bob:AirConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.air.AirConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:Amps a rdfs:Class ;
    rdfs:label "bob.properties.electricity.Amps" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:ElectricPower a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.electricity.ElectricPower" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

bob:ElectricPowerkW a rdfs:Class ;
    rdfs:label "bob.properties.electricity.ElectricPowerkW" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty,
        bob:ElectricPower .

bob:Flow a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.properties.flow.Flow" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty ;
    sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path bob:measuresMedium ] .

bob:HP a rdfs:Class ;
    rdfs:label "bob.properties.force.HP" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:HotWaterConnectionPoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "bob.connections.water.HotWaterConnectionPoint" ;
    rdfs:subClassOf s223:ConnectionPoint ;
    sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

bob:Percent a rdfs:Class ;
    rdfs:label "bob.properties.ratio.Percent" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:PercentCommand a rdfs:Class ;
    rdfs:label "bob.properties.ratio.PercentCommand" ;
    rdfs:subClassOf s223:ActuatableProperty,
        s223:Property,
        s223:QuantifiableActuatableProperty,
        s223:QuantifiableProperty .

bob:PowerFactor a rdfs:Class ;
    rdfs:label "bob.properties.electricity.PowerFactor" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:Pressure a rdfs:Class ;
    rdfs:label "bob.properties.force.Pressure" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:RPM a rdfs:Class ;
    rdfs:label "bob.properties.ratio.RPM" ;
    rdfs:subClassOf s223:ObservableProperty,
        s223:Property,
        s223:QuantifiableObservableProperty,
        s223:QuantifiableProperty .

bob:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

bob:isObservedBy a rdf:Property .

bob:measuresMedium a rdf:Property .

bob:onOffCommand a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

bob:onOffStatus a rdf:Property ;
    rdfs:subPropertyOf s223:hasProperty .

ex:AirFlowStation a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.AirFlowStation" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex:airOutlet ],
        [ a sh:PropertyShape ;
            sh:path ex:airInlet ] .

ex:Damper a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.Damper" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex:airOutlet ],
        [ a sh:PropertyShape ;
            sh:path ex:airInlet ] .

ex:DamperPositioner a rdfs:Class ;
    rdfs:label "__main__.DamperPositioner" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex:ECM a rdfs:Class ;
    rdfs:label "__main__.ECM" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex:ECMFan a rdfs:Class ;
    rdfs:label "__main__.ECMFan" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment,
        s223:Fan .

ex:HotWaterCoil a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.HotWaterCoil" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex:hwOutlet ],
        [ a sh:PropertyShape ;
            sh:path ex:airInlet ],
        [ a sh:PropertyShape ;
            sh:path ex:hwInlet ],
        [ a sh:PropertyShape ;
            sh:path ex:airOutlet ] .

ex:HotWaterValve a rdfs:Class ;
    rdfs:label "__main__.HotWaterValve" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex:VAV a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "__main__.VAV" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment ;
    sh:property [ a sh:PropertyShape ;
            sh:path ex:hwOutlet ],
        [ a sh:PropertyShape ;
            sh:path ex:supplyAirOutlet ],
        [ a sh:PropertyShape ;
            sh:path ex:supplyAirInlet ],
        [ a sh:PropertyShape ;
            sh:path ex:hwInlet ],
        [ a sh:PropertyShape ;
            sh:path ex:returnAirInlet ] .

ex:ValvePositioner a rdfs:Class ;
    rdfs:label "__main__.ValvePositioner" ;
    rdfs:subClassOf s223:Connectable,
        s223:Equipment .

ex:airInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:airOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:hwInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:hwOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:returnAirInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:supplyAirInlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

ex:supplyAirOutlet a rdf:Property ;
    rdfs:subPropertyOf s223:hasConnectionPoint .

