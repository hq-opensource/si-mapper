qudt:hasQuantityKind a rdf:Property .

qudt:hasUnit a rdf:Property .

s223:Connection sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

s223:ConnectionPoint sh:property [ a sh:PropertyShape ;
            sh:path s223:isConnectionPointOf ],
        [ a sh:PropertyShape ;
            sh:path s223:mapsTo ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ],
        [ a sh:PropertyShape ;
            sh:path s223:connectsThrough ] .

s223:Equipment sh:property [ a sh:PropertyShape ;
            sh:path s223:hasPhysicalLocation ] .

s223:Fan sh:property [ a sh:PropertyShape ;
            sh:path bob:airInlet ],
        [ a sh:PropertyShape ;
            sh:path bob:onOffStatus ],
        [ a sh:PropertyShape ;
            sh:path bob:onOffCommand ],
        [ a sh:PropertyShape ;
            sh:path bob:airOutlet ] .

s223:Junction sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:hasMedium ] .

s223:ObservableProperty sh:property [ a sh:PropertyShape ;
            sh:path bob:isObservedBy ] .

s223:Property sh:property [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofMedium ],
        [ a sh:PropertyShape ;
            sh:class s223:EnumerationKind ;
            sh:path s223:ofSubstance ],
        [ a sh:PropertyShape ;
            sh:path s223:hasValue ] .

s223:QuantifiableObservableProperty sh:property [ a sh:PropertyShape ;
            sh:path s223:hasSetpoint ] .

s223:QuantifiableProperty sh:property [ a sh:PropertyShape ;
            sh:path qudt:hasQuantityKind ],
        [ a sh:PropertyShape ;
            sh:path qudt:hasUnit ] .

