# ── Compose-level environment file ───────────────────────────────────────────
# Docker Compose reads this file automatically from the project root.
# Copy to .env and fill in your values before running `docker compose build`.
#
#   cp .env.example .env
#
# This file only needs to contain variables that are interpolated directly in
# docker-compose.yml (e.g. build args). Runtime variables for each service
# live in their own env files (mapper/docker.env, agent/docker.env, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend build args (NEXT_PUBLIC_* are inlined at build time by Next.js) ─
# These must be set here rather than in mapper/docker.env because Next.js bakes
# them into the JS bundle during `pnpm build`, which runs inside `docker compose
# build` — before docker.env is ever injected.

# URL the browser uses to reach the agent API (host-exposed port)
NEXT_PUBLIC_AGENT_BACKEND_URL=http://localhost:8001

# Graphivac grid URL embedded in the View/Edit iframe
# Format: https://<host>/o/<org_id>/p/<project_id>/g/<grid_id>
NEXT_PUBLIC_GRAPHIVAC_GRID_URL=

